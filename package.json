
{
  "name": "playwright-ai-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation with API testing and local AI failure analysis",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui --workers=1",
    "test:api": "playwright test tests/api --workers=1",
    "test:ci": "playwright test --grep-invert \"AI analyzes|DEMO:\" --workers=1"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "api-testing",
    "ai-testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "undici-types": "^8.9.0"
  }
}
